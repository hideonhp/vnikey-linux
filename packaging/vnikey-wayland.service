[Unit]
Description=VNIKey Vietnamese Input Method — Wayland
Documentation=https://github.com/hideonhp/vnikey-linux
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/vnikey-wayland
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
